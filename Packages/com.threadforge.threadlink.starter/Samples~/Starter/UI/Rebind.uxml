<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Starter.uss" />
    <ui:VisualElement class="starter-backdrop">
        <ui:VisualElement class="starter-panel">
            <ui:Label text="Change Control" class="starter-title" />
            <ui:Label name="prompt" text="" class="starter-text" />
            <ui:Label name="conflicts" text="" class="starter-note" />
            <ui:Button name="clear-conflicts" text="Clear Other Bindings" class="starter-button" />
            <ui:Button name="keep" text="Keep Both" class="starter-button" />
            <ui:Button name="cancel" text="Cancel" class="starter-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
