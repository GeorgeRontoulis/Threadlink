<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Starter.uss" />
    <ui:VisualElement class="starter-backdrop starter-loading">
        <ui:Label name="status" text="Loading…" class="starter-title">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="Threadlink Starter" entry="loading.status" />
            </Bindings>
        </ui:Label>
        <ui:Button name="retry" text="Retry" class="starter-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="Threadlink Starter" entry="loading.retry" />
            </Bindings>
        </ui:Button>
        <ui:Button name="quit" text="Quit" class="starter-button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="Threadlink Starter" entry="loading.quit" />
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
