<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Starter.uss" />
    <ui:VisualElement class="starter-backdrop">
        <ui:VisualElement class="starter-panel">
            <ui:Label name="title" text="Recover" class="starter-title" />
            <ui:Label name="detail" text="" class="starter-text" />
            <ui:ScrollView class="starter-list"><ui:VisualElement name="versions" /></ui:ScrollView>
            <ui:Button name="back" text="Back" class="starter-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Threadlink Starter" entry="recovery.back" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
