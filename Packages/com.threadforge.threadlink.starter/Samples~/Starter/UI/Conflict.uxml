<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Starter.uss" />
    <ui:VisualElement class="starter-backdrop">
        <ui:VisualElement class="starter-panel">
            <ui:Label text="Choose a Save" class="starter-title" />
            <ui:Label name="detail" text="" class="starter-text" />
            <ui:ScrollView class="starter-list"><ui:VisualElement name="versions" /></ui:ScrollView>
            <ui:Button name="keep-local" text="Keep Local Save" class="starter-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
