<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Starter.uss" />
    <ui:VisualElement class="starter-backdrop">
        <ui:VisualElement class="starter-panel">
            <ui:Label text="Paused" class="starter-title" />
            <ui:Button name="resume" text="Resume" class="starter-button" />
            <ui:Button name="save" text="Save Game" class="starter-button" />
            <ui:Button name="load" text="Load Game" class="starter-button" />
            <ui:Button name="settings" text="Settings" class="starter-button" />
            <ui:Button name="menu" text="Main Menu" class="starter-button" />
            <ui:Label name="status" text="" class="starter-note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
